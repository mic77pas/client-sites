# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions


# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# media pipeline -------------------------------------------------------------
# Full-res originals are the input to `npm run media`. Only the generated
# derivatives (public/media, content/media.json) need to be committed.
# Files already tracked under media/ stay tracked; new originals dropped into
# media/photos or media/video are ignored by default to keep the repo small.
# Remove these two lines if you'd rather version originals in Git LFS.
/media/photos/**/*
/media/video/*.mp4
/media/video/*.mov
!/media/video/*.json
# Portfolio hand-offs (zipped exports from Drive etc.): unpack, never commit.
*.zip
